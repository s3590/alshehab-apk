{
  "appId": "com.alshehab.pro",
  "appName": "الشهاب Pro",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "my-bot-ehio.onrender.com",
      "*.onrender.com",
      "github.com",
      "*.github.com",
      "*.githubusercontent.com"
    ]
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": false
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": true,
      "backgroundColor": "#050b14",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP"
    }
  },
  "android": {
    "appendUserAgent": "AlshehabAPK",
    "allowMixedContent": true
  }
}
